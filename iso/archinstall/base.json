{
  "archinstall-language": "English",
  "audio_config": {
    "audio": "pipewire"
  },
  "bootloader_config": {
    "bootloader": "Grub",
    "uki": false,
    "removable": true
  },
  "kernels": [
    "linux"
  ],
  "locale_config": {
    "kb_layout": "us",
    "sys_enc": "UTF-8",
    "sys_lang": "en_US"
  },
  "mirror_config": {
    "mirror_regions": {},
    "custom_servers": [
      {
        "url": "https://geo.mirror.pkgbuild.com/$repo/os/$arch"
      }
    ],
    "optional_repositories": [],
    "custom_repositories": []
  },
  "network_config": {
    "type": "nm"
  },
  "ntp": true,
  "packages": [
    "git",
    "openssh"
  ],
  "services": [],
  "pacman_config": {
    "color": true,
    "parallel_downloads": 5
  },
  "profile_config": {
    "gfx_driver": null,
    "greeter": null,
    "profile": {
      "main": "Minimal"
    }
  },
  "swap": {
    "enabled": true,
    "algorithm": "zstd"
  },
  "timezone": "America/Mexico_City"
}
