# Catppuccin Macchiato — yazi theme for the central switcher (yazi ≥ 25.x schema).
# Templated from catppuccin/yazi (mauve accent). UI chrome only: file icons and
# code-preview syntax highlighting fall back to yazi's defaults.

[app]
overall = { bg = "#24273a" }

[mgr]
cwd = { fg = "#8bd5ca" }

find_keyword  = { fg = "#eed49f", italic = true }
find_position = { fg = "#f5bde6", bg = "reset", italic = true }

marker_copied   = { fg = "#a6da95", bg = "#a6da95" }
marker_cut      = { fg = "#ed8796", bg = "#ed8796" }
marker_marked   = { fg = "#8bd5ca", bg = "#8bd5ca" }
marker_selected = { fg = "#c6a0f6", bg = "#c6a0f6" }

count_copied   = { fg = "#24273a", bg = "#a6da95" }
count_cut      = { fg = "#24273a", bg = "#ed8796" }
count_selected = { fg = "#24273a", bg = "#c6a0f6" }

border_symbol = "│"
border_style  = { fg = "#8087a2" }

[tabs]
active   = { fg = "#24273a", bg = "#cad3f5", bold = true }
inactive = { fg = "#cad3f5", bg = "#494d64" }

[mode]
normal_main = { fg = "#24273a", bg = "#c6a0f6", bold = true }
normal_alt  = { fg = "#c6a0f6", bg = "#363a4f" }

select_main = { fg = "#24273a", bg = "#a6da95", bold = true }
select_alt  = { fg = "#a6da95", bg = "#363a4f" }

unset_main  = { fg = "#24273a", bg = "#f0c6c6", bold = true }
unset_alt   = { fg = "#f0c6c6", bg = "#363a4f" }

[indicator]
parent  = { fg = "#24273a", bg = "#cad3f5" }
current = { fg = "#24273a", bg = "#c6a0f6" }
preview = { fg = "#24273a", bg = "#cad3f5" }

[status]
sep_left  = { open = "", close = "" }
sep_right = { open = "", close = "" }

progress_label  = { fg = "#cad3f5", bold = true }
progress_normal = { fg = "#a6da95", bg = "#494d64" }
progress_error  = { fg = "#eed49f", bg = "#ed8796" }

perm_type  = { fg = "#8aadf4" }
perm_read  = { fg = "#eed49f" }
perm_write = { fg = "#ed8796" }
perm_exec  = { fg = "#a6da95" }
perm_sep   = { fg = "#8087a2" }

[input]
border   = { fg = "#c6a0f6" }
title    = {}
value    = {}
selected = { reversed = true }

[pick]
border   = { fg = "#c6a0f6" }
active   = { fg = "#f5bde6" }
inactive = {}

[confirm]
border  = { fg = "#c6a0f6" }
title   = { fg = "#c6a0f6" }
body    = {}
list    = {}
btn_yes = { reversed = true }
btn_no  = {}

[cmp]
border = { fg = "#c6a0f6" }

[tasks]
border  = { fg = "#c6a0f6" }
title   = {}
hovered = { fg = "#f5bde6", bold = true }

[which]
border          = { fg = "#c6a0f6" }
mask            = {}
cand            = { fg = "#8bd5ca" }
rest            = { fg = "#939ab7" }
desc            = { fg = "#f5bde6" }
separator       = "  "
separator_style = { fg = "#5b6078" }

[help]
border  = { fg = "#c6a0f6" }
chord   = { fg = "#8bd5ca" }
action  = { fg = "#939ab7" }
hovered = { bg = "#5b6078", bold = true }

[notify]
title_info  = { fg = "#8bd5ca" }
title_warn  = { fg = "#eed49f" }
title_error = { fg = "#ed8796" }

[filetype]
rules = [
	{ mime = "**/image/*", fg = "#eed49f" },
	{ mime = "**/{audio,video}/*", fg = "#f5bde6" },
	{ mime = "**/application/{zip,rar,7z*,tar,gzip,xz,zstd,bzip*,lzma,compress,archive,cpio,arj,xar,ms-cab*}", fg = "#ed8796" },
	{ mime = "**/application/{pdf,doc,rtf}", fg = "#91d7e3" },
	{ mime = "vfs/{absent,stale}", fg = "#494d64" },
	{ url = "*", is = "orphan", bg = "#ed8796" },
	{ url = "*", is = "exec", fg = "#a6da95" },
	{ url = "*", is = "dummy", bg = "#ed8796" },
	{ url = "*/", is = "dummy", bg = "#ed8796" },
	{ url = "*/", fg = "#c6a0f6" },
]

[spot]
border   = { fg = "#c6a0f6" }
title    = { fg = "#c6a0f6" }
tbl_cell = { fg = "#c6a0f6", reversed = true }
tbl_col  = { bold = true }
