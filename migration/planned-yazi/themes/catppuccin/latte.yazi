# Catppuccin Latte (light) — yazi theme for the central switcher (yazi ≥ 25.x schema).
# Templated from catppuccin/yazi (mauve accent). UI chrome only: file icons and
# code-preview syntax highlighting fall back to yazi's defaults.

[app]
overall = { bg = "#eff1f5" }

[mgr]
cwd = { fg = "#179299" }

find_keyword  = { fg = "#df8e1d", italic = true }
find_position = { fg = "#ea76cb", bg = "reset", italic = true }

marker_copied   = { fg = "#40a02b", bg = "#40a02b" }
marker_cut      = { fg = "#d20f39", bg = "#d20f39" }
marker_marked   = { fg = "#179299", bg = "#179299" }
marker_selected = { fg = "#8839ef", bg = "#8839ef" }

count_copied   = { fg = "#eff1f5", bg = "#40a02b" }
count_cut      = { fg = "#eff1f5", bg = "#d20f39" }
count_selected = { fg = "#eff1f5", bg = "#8839ef" }

border_symbol = "│"
border_style  = { fg = "#8c8fa1" }

[tabs]
active   = { fg = "#eff1f5", bg = "#4c4f69", bold = true }
inactive = { fg = "#4c4f69", bg = "#bcc0cc" }

[mode]
normal_main = { fg = "#eff1f5", bg = "#8839ef", bold = true }
normal_alt  = { fg = "#8839ef", bg = "#ccd0da" }

select_main = { fg = "#eff1f5", bg = "#40a02b", bold = true }
select_alt  = { fg = "#40a02b", bg = "#ccd0da" }

unset_main  = { fg = "#eff1f5", bg = "#dd7878", bold = true }
unset_alt   = { fg = "#dd7878", bg = "#ccd0da" }

[indicator]
parent  = { fg = "#eff1f5", bg = "#4c4f69" }
current = { fg = "#eff1f5", bg = "#8839ef" }
preview = { fg = "#eff1f5", bg = "#4c4f69" }

[status]
sep_left  = { open = "", close = "" }
sep_right = { open = "", close = "" }

progress_label  = { fg = "#4c4f69", bold = true }
progress_normal = { fg = "#40a02b", bg = "#bcc0cc" }
progress_error  = { fg = "#df8e1d", bg = "#d20f39" }

perm_type  = { fg = "#1e66f5" }
perm_read  = { fg = "#df8e1d" }
perm_write = { fg = "#d20f39" }
perm_exec  = { fg = "#40a02b" }
perm_sep   = { fg = "#8c8fa1" }

[input]
border   = { fg = "#8839ef" }
title    = {}
value    = {}
selected = { reversed = true }

[pick]
border   = { fg = "#8839ef" }
active   = { fg = "#ea76cb" }
inactive = {}

[confirm]
border  = { fg = "#8839ef" }
title   = { fg = "#8839ef" }
body    = {}
list    = {}
btn_yes = { reversed = true }
btn_no  = {}

[cmp]
border = { fg = "#8839ef" }

[tasks]
border  = { fg = "#8839ef" }
title   = {}
hovered = { fg = "#ea76cb", bold = true }

[which]
border          = { fg = "#8839ef" }
mask            = {}
cand            = { fg = "#179299" }
rest            = { fg = "#7c7f93" }
desc            = { fg = "#ea76cb" }
separator       = "  "
separator_style = { fg = "#acb0be" }

[help]
border  = { fg = "#8839ef" }
chord   = { fg = "#179299" }
action  = { fg = "#7c7f93" }
hovered = { bg = "#acb0be", bold = true }

[notify]
title_info  = { fg = "#179299" }
title_warn  = { fg = "#df8e1d" }
title_error = { fg = "#d20f39" }

[filetype]
rules = [
	{ mime = "**/image/*", fg = "#df8e1d" },
	{ mime = "**/{audio,video}/*", fg = "#ea76cb" },
	{ mime = "**/application/{zip,rar,7z*,tar,gzip,xz,zstd,bzip*,lzma,compress,archive,cpio,arj,xar,ms-cab*}", fg = "#d20f39" },
	{ mime = "**/application/{pdf,doc,rtf}", fg = "#04a5e5" },
	{ mime = "vfs/{absent,stale}", fg = "#bcc0cc" },
	{ url = "*", is = "orphan", bg = "#d20f39" },
	{ url = "*", is = "exec", fg = "#40a02b" },
	{ url = "*", is = "dummy", bg = "#d20f39" },
	{ url = "*/", is = "dummy", bg = "#d20f39" },
	{ url = "*/", fg = "#8839ef" },
]

[spot]
border   = { fg = "#8839ef" }
title    = { fg = "#8839ef" }
tbl_cell = { fg = "#8839ef", reversed = true }
tbl_col  = { bold = true }
