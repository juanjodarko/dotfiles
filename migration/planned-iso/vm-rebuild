#!/usr/bin/env bash
#
# vm-rebuild — wipe the test VM and reinstall Arch unattended (no keyboard).
#
# Boots the stock Arch ISO with a cloud-init `cidata` seed (the same NoCloud
# mechanism Omarchy's ISO uses). cloud-init runs archinstall with
# archinstall/user_configuration.json + creds.json, then drops the laptop's SSH
# key into the new system and powers off. The VM is then rebooted from disk.
#
# VM-only conveniences added by the seed (NOT part of the archinstall config):
#   - your SSH public key in ~juanjo/.ssh/authorized_keys
#   - passwordless sudo for juanjo (so install.sh can be driven over SSH)
#
# Usage: vm-rebuild [--yes]
#   creds.json must exist first:
#     cd archinstall && umask 077 && printf '{"users":[{"username":"juanjo","sudo":true,"enc_password":"%s"}]}\n' "$(openssl passwd -6)" > creds.json
#
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VM="${VM:-arch-dotfiles}"
ISO="${ISO:-$HOME/vms/archlinux-2026.10.01-x86_64.iso}"
SEED="${SEED:-$HOME/vms/$VM-cidata.iso}"
CFG="$HERE/archinstall/user_configuration.json"
CREDS="$HERE/archinstall/creds.json"
PUBKEY="${PUBKEY:-$(ls "$HOME"/.ssh/id_ed25519.pub "$HOME"/.ssh/id_rsa.pub 2>/dev/null | head -1)}"
INSTALL_TIMEOUT="${INSTALL_TIMEOUT:-2700}"   # seconds to wait for the unattended install

export LIBVIRT_DEFAULT_URI=qemu:///system
# virt-* tools need the system python (a mise python on PATH lacks `gi`).
virt_xml() { /usr/bin/python3 /usr/bin/virt-xml "$@"; }

log() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
die() { printf '\033[1;31mxx \033[0m %s\n' "$*" >&2; exit 1; }

[ -f "$CFG" ]    || die "missing $CFG"
[ -f "$CREDS" ]  || die "missing $CREDS — create it (see the header of this script)"
[ -f "$ISO" ]    || die "missing Arch ISO: $ISO"
[ -n "$PUBKEY" ] && [ -f "$PUBKEY" ] || die "no SSH public key found (set PUBKEY=)"
command -v xorriso >/dev/null || die "xorriso is required (pacman -S libisoburn)"
virsh dominfo "$VM" >/dev/null 2>&1 || die "VM '$VM' does not exist"
# With socket-activated libvirt daemons, network autostart doesn't run at boot.
[ "$(virsh net-info default 2>/dev/null | awk '/^Active:/ {print $2}')" = yes ] || virsh net-start default >/dev/null

if [ "${1:-}" != "--yes" ]; then
  read -rp "This WIPES the disk of VM '$VM' and reinstalls it. Continue? [y/N] " a
  [[ "$a" =~ ^[Yy]$ ]] || exit 1
fi

# ---------------------------------------------------------------- seed ----
work="$(mktemp -d)"; trap 'rm -rf "$work"' EXIT
key="$(cat "$PUBKEY")"

cat > "$work/autoinstall.sh" <<'EOS'
#!/usr/bin/env bash
set -euo pipefail
exec > >(tee -a /var/log/vm-autoinstall.log) 2>&1
echo "[autoinstall] start $(date)"
systemctl start pacman-init.service            # keyring must be ready first
until curl -fsI https://geo.mirror.pkgbuild.com >/dev/null; do sleep 3; done
archinstall --config /root/vm/user_configuration.json --creds /root/vm/creds.json --silent
mountpoint -q /mnt || mount /dev/vda2 /mnt
mountpoint -q /mnt/boot || mount /dev/vda1 /mnt/boot
uid="$(arch-chroot /mnt id -u juanjo)"; gid="$(arch-chroot /mnt id -g juanjo)"
install -d -m700 -o "$uid" -g "$gid" /mnt/home/juanjo/.ssh
install -m600 -o "$uid" -g "$gid" /root/vm/authorized_keys /mnt/home/juanjo/.ssh/authorized_keys
install -m440 /dev/stdin /mnt/etc/sudoers.d/90-vm-nopasswd <<<'juanjo ALL=(ALL) NOPASSWD: ALL'
cp /var/log/vm-autoinstall.log /mnt/var/log/ 2>/dev/null || true
umount -R /mnt
echo "[autoinstall] done $(date)"
systemctl poweroff
EOS

b64() { base64 -w0 "$1"; }
cat > "$work/user-data" <<EOF
#cloud-config
disable_root: false
users:
  - name: root
    ssh_authorized_keys:
      - $key
write_files:
  - path: /root/vm/user_configuration.json
    encoding: b64
    content: $(b64 "$CFG")
  - path: /root/vm/creds.json
    permissions: '0600'
    encoding: b64
    content: $(b64 "$CREDS")
  - path: /root/vm/authorized_keys
    encoding: b64
    content: $(printf '%s\n' "$key" | base64 -w0)
  - path: /root/vm/autoinstall.sh
    permissions: '0755'
    encoding: b64
    content: $(b64 "$work/autoinstall.sh")
runcmd:
  - [ bash, /root/vm/autoinstall.sh ]
EOF
printf 'instance-id: %s-%s\nlocal-hostname: archiso\n' "$VM" "$(date +%s)" > "$work/meta-data"
rm -f "$SEED"
xorriso -as mkisofs -quiet -o "$SEED" -V cidata -J -r "$work/user-data" "$work/meta-data"
chmod 644 "$SEED"
log "Seed built: $SEED"

# ------------------------------------------------------------- install ----
virsh destroy "$VM" >/dev/null 2>&1 || true
virsh change-media "$VM" sda "$ISO" --insert --config >/dev/null
if virsh domblklist "$VM" | awk '{print $1}' | grep -qx sdb; then
  virsh change-media "$VM" sdb "$SEED" --insert --config >/dev/null
else
  virsh attach-disk "$VM" "$SEED" sdb --type cdrom --mode readonly --targetbus sata --config >/dev/null
fi
virt_xml "$VM" --edit --boot cdrom,hd >/dev/null
virsh start "$VM" >/dev/null
log "Installing unattended (ISO + cidata). Live ISO accepts: ssh root@<vm-ip> 'tail -f /var/log/vm-autoinstall.log'"

waited=0
until [ "$(virsh domstate "$VM")" = "shut off" ]; do
  sleep 15; waited=$((waited + 15))
  [ "$waited" -lt "$INSTALL_TIMEOUT" ] || die "install did not finish in ${INSTALL_TIMEOUT}s — VM left running; check the log over SSH"
done
log "Install finished after ${waited}s; booting the installed system."

# --------------------------------------------------------------- boot -----
virsh change-media "$VM" sda --eject --config >/dev/null
virsh change-media "$VM" sdb --eject --config >/dev/null
virt_xml "$VM" --edit --boot hd >/dev/null
virsh start "$VM" >/dev/null

forgot=""
for _ in $(seq 60); do
  ip="$(virsh domifaddr "$VM" 2>/dev/null | awk '/ipv4/ {split($4,a,"/"); print a[1]; exit}')"
  # Every rebuild has a fresh host key; drop the previous one for this IP.
  if [ -n "$ip" ] && [ "$forgot" != "$ip" ]; then
    ssh-keygen -q -R "$ip" -f "$HOME/.ssh/known_hosts.vms" >/dev/null 2>&1 || true
    forgot="$ip"
  fi
  if [ -n "$ip" ] && ssh -o BatchMode=yes -o ConnectTimeout=3 -o StrictHostKeyChecking=accept-new \
       -o UserKnownHostsFile="$HOME/.ssh/known_hosts.vms" "juanjo@$ip" true 2>/dev/null; then
    log "Ready: ssh -o UserKnownHostsFile=~/.ssh/known_hosts.vms juanjo@$ip"
    exit 0
  fi
  sleep 5
done
die "installed system did not come up on SSH"
