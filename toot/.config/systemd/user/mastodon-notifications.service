[Unit]
Description=Mastodon Notification Daemon
Documentation=man:toot(1)
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/mastodon-notifications daemon
Restart=on-failure
RestartSec=30

# Environment
Environment="MASTODON_CHECK_INTERVAL=60"

# Security
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=default.target
