# Auto-generated hyprpaper config example
# This file is generated automatically by generate_hyprpaper_config.sh
# DO NOT EDIT THIS FILE MANUALLY - it will be overwritten
#
# The actual hyprpaper.conf is auto-generated and contains:
# 1. Preload directives for all wallpapers in ~/wallpapers/
# 2. Wallpaper assignments for each detected monitor
# 3. A default fallback wallpaper for new monitors

# Example preload directives (one per wallpaper):
preload = /home/user/wallpapers/wallpaper1.jpg
preload = /home/user/wallpapers/wallpaper2.png
preload = /home/user/wallpapers/wallpaper3.jpeg

# Example monitor-specific wallpaper assignments:
# Format: wallpaper = <monitor_name>,<wallpaper_path>
wallpaper = eDP-1,/home/user/wallpapers/wallpaper1.jpg
wallpaper = DP-1,/home/user/wallpapers/wallpaper2.png
wallpaper = HDMI-A-1,/home/user/wallpapers/wallpaper3.jpeg

# Default fallback for unspecified monitors:
wallpaper = ,/home/user/wallpapers/wallpaper1.jpg
