# vim:ft=kitty
# Catppuccin Frappé (Dark) — palette mirrors frappe.ghostty (single source of truth).
# This file is the switch target of ~/.config/themes/current.kitty.

foreground            #c6d0f5
background            #303446
selection_foreground  #303446
selection_background  #f2d5cf

cursor                #f2d5cf
cursor_text_color     #303446

url_color             #81c8be

active_border_color   #8caaee
inactive_border_color #626880

active_tab_foreground   #303446
active_tab_background   #8caaee
inactive_tab_foreground #c6d0f5
inactive_tab_background #51576d

# black
color0  #51576d
color8  #626880
# red
color1  #e78284
color9  #e78284
# green
color2  #a6d189
color10 #a6d189
# yellow
color3  #e5c890
color11 #e5c890
# blue
color4  #8caaee
color12 #8caaee
# magenta
color5  #f4b8e4
color13 #f4b8e4
# cyan
color6  #81c8be
