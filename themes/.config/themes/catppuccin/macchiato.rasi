/* Catppuccin Macchiato Theme for Rofi (Dark) */

* {
    /* Catppuccin Macchiato Colors */
    bg: #24273a;
    bg-alt: #1e2030;
    fg: #cad3f5;
    fg-alt: #b8c0e0;

    surface0: #363a4f;
    surface1: #494d64;
    surface2: #5b6078;

    lavender: #b7bdf8;
    blue: #8aadf4;
    sapphire: #7dc4e4;
    sky: #91d7e3;
    teal: #8bd5ca;
    green: #a6da95;
    yellow: #eed49f;
    peach: #f5a97f;
    maroon: #ee99a0;
    red: #ed8796;
    mauve: #c6a0f6;
    pink: #f5bde6;

    background-color: transparent;
    text-color: @fg;
    font: "CaskaydiaCove Nerd Font 14";
}

window {
    location: center;
    width: 600px;
    border-radius: 16px;
    background-color: @bg;
    border: 2px solid;
    border-color: @lavender;
}

mainbox {
    padding: 12px;
    background-color: transparent;
}

inputbar {
    padding: 12px;
    margin: 0px 0px 12px 0px;
    background-color: @surface0;
    border-radius: 12px;
    children: [prompt, entry];
}

prompt {
    padding: 8px 12px;
    background-color: @lavender;
    text-color: @bg;
    border-radius: 8px;
    margin: 0px 12px 0px 0px;
}

entry {
    placeholder: "Search...";
    placeholder-color: @fg-alt;
    text-color: @fg;
    background-color: transparent;
}

listview {
    columns: 1;
    lines: 8;
    spacing: 6px;
    padding: 8px 0px;
    background-color: transparent;
    scrollbar: false;
}

element {
    padding: 12px;
    border-radius: 10px;
    background-color: transparent;
    text-color: @fg;
}

element normal.normal {
    background-color: transparent;
    text-color: @fg;
}

element selected.normal {
    background-color: @surface1;
    text-color: @lavender;
}

element alternate.normal {
    background-color: transparent;
    text-color: @fg;
}

element-icon {
    size: 48px;
    margin: 0px 16px 0px 0px;
    background-color: transparent;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
}

/* Mode Switcher (bottom tabs) */
mode-switcher {
    margin: 12px 0px 0px 0px;
    spacing: 8px;
}

button {
    padding: 10px;
    background-color: @surface0;
    text-color: @fg-alt;
    border-radius: 8px;
}

button selected {
    background-color: @lavender;
    text-color: @bg;
}

/* Messages */
message {
    padding: 12px;
    background-color: @surface0;
    border-radius: 12px;
    margin: 0px 0px 12px 0px;
}

textbox {
    text-color: @fg;
    background-color: transparent;
}
