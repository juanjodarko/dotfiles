# vim:ft=kitty
# Catppuccin Latte (Light) — palette mirrors latte.ghostty (single source of truth).
# This file is the switch target of ~/.config/themes/current.kitty.

foreground            #4c4f69
background            #eff1f5
selection_foreground  #eff1f5
selection_background  #dc8a78

cursor                #dc8a78
cursor_text_color     #eff1f5

url_color             #179299

active_border_color   #1e66f5
inactive_border_color #acb0be

active_tab_foreground   #eff1f5
active_tab_background   #1e66f5
inactive_tab_foreground #4c4f69
inactive_tab_background #bcc0cc

# black
color0  #bcc0cc
color8  #acb0be
# red
color1  #d20f39
color9  #d20f39
# green
color2  #40a02b
color10 #40a02b
# yellow
color3  #df8e1d
color11 #df8e1d
