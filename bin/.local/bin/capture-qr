#!/bin/bash

# capture-qr — decode a QR code from a selected screen region into the clipboard.
# Ported from Omarchy (basecamp/omarchy bin/omarchy-capture-qr, MIT).

# Keep hyprpicker alive until after grim captures so the screenshot sees the
# frozen overlay rather than live content shifting during teardown.
cleanup_freeze() {
  [[ -n $PID ]] && kill $PID 2>/dev/null
}
trap cleanup_freeze EXIT

hyprpicker -r -z >/dev/null 2>&1 &
PID=$!
sleep .1
SELECTION=$(slurp 2>/dev/null)

[[ -z $SELECTION ]] && exit 0

# QR only: other symbologies false-positive on dense screen content.
RESULT=$(grim -g "$SELECTION" - | zbarimg -q --raw -Sdisable -Sqrcode.enable - 2>/dev/null)

if [[ -z $RESULT ]]; then
  notify-send -a "Capture" -u critical "No QR code found" "Select a region containing a QR code"
  exit 1
fi

# QR codes often carry secrets (otpauth:// 2FA URIs), so the value goes only to
# the clipboard, marked sensitive so clipboard history skips it — never printed
# or shown in the notification.
printf '%s' "$RESULT" | wl-copy --sensitive
notify-send -a "Capture" "QR code copied to clipboard"
