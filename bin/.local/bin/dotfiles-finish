#!/usr/bin/env bash
#
# dotfiles-finish — second half of a fresh install, run once in the desktop.
#
# The ISO installs everything from the PUBLIC dotfiles repo. The private
# submodules (DockShell, personal, git, mac_personal) need a GitHub login, which
# is easy here: a GitHub token is read from 1Password via the desktop app (falls
# back to gh's browser login). Then the private modules are stowed,
# setup.sh re-runs inside the real session (user services etc.), and DockShell
# starts.
#
#   dotfiles-finish --if-pending   # Hyprland autostart: no-op unless DockShell is missing
#   dotfiles-finish                # run it by hand
#
set -euo pipefail

DOTFILES="${DOTFILES:-$HOME/dotfiles}"
pending() { [ -d "$DOTFILES/.git" ] && [ ! -e "$DOTFILES/quickshell/.config/quickshell/shell.qml" ]; }

if [ "${1:-}" = --if-pending ]; then
  pending || exit 0
  # open a visible terminal for the login + progress
  exec kitty --title "Finish dotfiles setup" env DOTFILES_FINISH_TERM=1 "$0"
fi

# GitHub token from 1Password (personal setup): the desktop app unlocks it, the
# CLI reads it through the app integration, gh takes it — no browser needed.
# Looked up by item name across all vaults (override: DOTFILES_GH_TOKEN_ITEM/_FIELD).
GH_TOKEN_ITEM="${DOTFILES_GH_TOKEN_ITEM:-GitHub Personal Access Token}"
GH_TOKEN_FIELD="${DOTFILES_GH_TOKEN_FIELD:-token}"

github_login_from_1password() {
  command -v op >/dev/null && command -v 1password >/dev/null || return 1
  pgrep -x 1password >/dev/null || (setsid 1password >/dev/null 2>&1 &)
  echo "Sign in to 1Password in its window (scanning the QR code with your phone works),"
  echo "then in 1Password → Settings → Developer, turn on \"Integrate with 1Password CLI\"."
  echo "Waiting for the GitHub token (1Password item \"$GH_TOKEN_ITEM\")…"
  local token="" _
  for _ in $(seq 120); do   # up to ~10 min
    token="$(op item get "$GH_TOKEN_ITEM" --fields "label=$GH_TOKEN_FIELD" --reveal 2>/dev/null)" && [ -n "$token" ] && break
    sleep 5
  done
  [ -n "$token" ] || { echo "Could not read the token from 1Password."; return 1; }
  printf '%s\n' "$token" | gh auth login --hostname github.com --git-protocol https --with-token
  gh auth status >/dev/null 2>&1 && echo "GitHub: logged in with the 1Password token."
}

run() {
  echo "==> Finishing your dotfiles setup"
  echo
  if ! gh auth status >/dev/null 2>&1; then
    github_login_from_1password || {
      echo "Falling back to the browser login (approve it in the browser window)…"
      gh auth login --hostname github.com --git-protocol https --web
    }
  fi
  # Credential helper + https rewrite go to ~/.config/git/config, NOT ~/.gitconfig:
  # the `git` module stows ~/.gitconfig, and a real file there would block it.
  xdg_git="$HOME/.config/git/config"; mkdir -p "$(dirname "$xdg_git")"
  git config --file "$xdg_git" --replace-all credential.https://github.com.helper ''
  git config --file "$xdg_git" --add credential.https://github.com.helper '!/usr/bin/gh auth git-credential'
  git config --file "$xdg_git" url.https://github.com/.insteadOf git@github.com:

  echo "==> Fetching the private submodules"
  git -C "$DOTFILES" submodule update --init --recursive --recommend-shallow

  echo "==> Linking them"
  cd "$DOTFILES"
  stow -R personal quickshell git

  echo "==> Re-running setup inside the session"
  ./setup/setup.sh </dev/tty || echo "setup.sh reported warnings (see above)"

  echo "==> Starting DockShell"
  command -v dockshell-restart >/dev/null && dockshell-restart \
    || (setsid quickshell -p "$HOME/.config/quickshell" >/dev/null 2>&1 &)
  echo
  echo "All done."
}

if run; then
  [ -n "${DOTFILES_FINISH_TERM:-}" ] && read -rp "Press Enter to close…" _
else
  echo
  echo "Something failed. Fix it and run: dotfiles-finish"
  [ -n "${DOTFILES_FINISH_TERM:-}" ] && read -rp "Press Enter to close…" _
  exit 1
fi
