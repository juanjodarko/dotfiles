#!/usr/bin/env bash
# theme-set [<flavor>] — headless Catppuccin theme backend (single source of truth).
#
# With a flavor (mocha|latte|frappe|macchiato): swap the ~/.config/themes/current.*
# symlinks + the DockShell palette (current.json), update starship, and reload the
# live apps. With no argument: print the current flavor.
#
# Frontends (the wofi menu, Vicinae's "Switch Theme", a future DockShell control)
# all call this so the swap logic lives in one place. DockShell re-tints itself by
# watching current.json — no bar restart needed (the old waybar restart is gone).

THEMES_DIR="$HOME/.config/themes"
CURRENT_FLAVOR="$THEMES_DIR/current_flavor.txt"
STARSHIP_CONFIG="$HOME/.config/starship.toml"
TMUX_CONFIG="$HOME/.config/tmux/tmux.conf"
CURRENT_STARSHIP="$THEMES_DIR/current.starship"

flavors="mocha latte frappe macchiato"

# --- query mode: print the current flavor -----------------------------------
if [ $# -eq 0 ]; then
  if [ -f "$CURRENT_FLAVOR" ]; then cat "$CURRENT_FLAVOR"; exit 0; fi
  link=$(readlink "$THEMES_DIR/current.css" 2>/dev/null)
  case "$link" in
    catppuccin/mocha.css) echo mocha ;;
    catppuccin/latte.css) echo latte ;;
    catppuccin/frappe.css) echo frappe ;;
    catppuccin/macchiato.css) echo macchiato ;;
    *) echo unknown ;;
  esac
  exit 0
fi

flavor="$1"
case " $flavors " in *" $flavor "*) ;; *)
  echo "usage: theme-set [<mocha|latte|frappe|macchiato>]" >&2; exit 1 ;;
esac

cd "$THEMES_DIR" || { echo "theme-set: $THEMES_DIR missing" >&2; exit 1; }

# --- central symlinks -------------------------------------------------------
ln -sf "catppuccin/${flavor}.css" current.css
ln -sf "catppuccin/${flavor}.rasi" current.rasi
ln -sf "catppuccin/${flavor}.ghostty" current.ghostty
ln -sf "catppuccin/${flavor}.kitty" current.kitty
ln -sf "catppuccin/${flavor}.tmux" current.tmux
ln -sf "../../../hyprland/.config/hypr/${flavor}.conf" current.conf
ln -sf "catppuccin/${flavor}.starship" current.starship

# Bar palette for Quickshell/DockShell — a REAL file written atomically (mv), not
# a symlink: the FileView watcher fires reliably on rename, but can miss a relink.
if [ -f "palettes/catppuccin/${flavor}.json" ]; then
  install -m644 "palettes/catppuccin/${flavor}.json" ".current.json.tmp" \
    && mv -f ".current.json.tmp" "current.json"
fi

echo "$flavor" > "$CURRENT_FLAVOR"

# --- starship palette (auto-managed blocks) ---------------------------------
if [ -f "$STARSHIP_CONFIG" ] && [ -f "$CURRENT_STARSHIP" ]; then
  theme_colors=$(cat "$CURRENT_STARSHIP")
  theme_palette="catppuccin_${flavor}"
  temp_file=$(mktemp)
  awk -v palette="$theme_palette" '
    /^# === THEME PALETTE START ===/ {
      print
      print "# This line is automatically managed by the theme switcher"
      print "# Do not manually edit this line"
      print "palette = '\''" palette "'\''"
      skip=1; next
    }
    /^# === THEME PALETTE END ===/ { skip=0; print; next }
    !skip
  ' "$STARSHIP_CONFIG" > "$temp_file.step1"
  awk -v theme="$theme_colors" '
    /^# === THEME COLORS START ===/ {
      print
      print "# This section is automatically managed by the theme switcher"
      print "# Do not manually edit between THEME COLORS START and END markers"
      print theme
      skip=1; next
    }
    /^# === THEME COLORS END ===/ { skip=0 }
    !skip
  ' "$temp_file.step1" > "$temp_file"
  mv "$temp_file" "$STARSHIP_CONFIG"
  rm -f "$temp_file.step1"
fi

# --- reload live apps -------------------------------------------------------
# DockShell (Quickshell) re-tints via its current.json FileView watch — no restart.
pkill -SIGUSR2 ghostty 2>/dev/null            # ghostty re-reads config
pkill -SIGUSR1 kitty   2>/dev/null            # kitty re-reads config
command -v swaync-client >/dev/null 2>&1 && swaync-client -rs 2>/dev/null &

if [ -n "${TMUX:-}" ] || pgrep -x tmux >/dev/null 2>&1; then
  tmux source-file "$TMUX_CONFIG" 2>/dev/null || true
fi

NVIM_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
for sock in "$NVIM_RUNTIME_DIR"/nvim.*.sock; do
  [ -S "$sock" ] && nvim --server "$sock" --remote-send ":colorscheme catppuccin-${flavor}<CR>" 2>/dev/null &
done

pgrep -x Hyprland >/dev/null 2>&1 && hyprctl reload >/dev/null 2>&1 &

# Vicinae launcher (if installed): keep its UI theme in sync with the flavor.
command -v vicinae >/dev/null 2>&1 && vicinae theme set "catppuccin-${flavor}" >/dev/null 2>&1 &

# SDDM login screen (passwordless via polkit rule)
if command -v pkexec >/dev/null 2>&1 && [ -f /usr/local/bin/update-sddm-theme ]; then
  pkexec /usr/local/bin/update-sddm-theme "$flavor" 2>/dev/null &
fi

notify-send "Theme" "Switched to Catppuccin ${flavor^}" -i preferences-desktop-theme 2>/dev/null || true
exit 0
