#!/usr/bin/env bash
# update-greeter-theme <palette.json>
# Render /etc/greetd/regreet.css from a Catppuccin semantic palette (roles from current.json / a flavor file).
# Runs as root (via pkexec) because it writes under /etc. STAGED SPEC — intended: /usr/local/bin/update-greeter-theme
set -euo pipefail

PAL="${1:?usage: update-greeter-theme <palette.json>}"
[ -r "$PAL" ] || { echo "palette not readable: $PAL" >&2; exit 1; }
command -v jq >/dev/null || { echo "jq required" >&2; exit 1; }

OUT="/etc/greetd/regreet.css"
r() { jq -er ".roles.$1" "$PAL"; }
bg=$(r bg); bg_alt=$(r bg_alt); surface=$(r surface); overlay=$(r overlay)
fg=$(r fg); muted=$(r muted); accent=$(r accent); urgent=$(r urgent)

cat > "$OUT" <<CSS
/* GENERATED by update-greeter-theme from $(basename "$PAL") — do not hand-edit. GTK4 CSS. */
@define-color bg $bg;
@define-color bg_alt $bg_alt;
@define-color surface $surface;
@define-color overlay $overlay;
@define-color fg $fg;
@define-color muted $muted;
@define-color accent $accent;
@define-color urgent $urgent;

window { background-color: transparent; color: @fg; }
box.card, .card { background-color: alpha(@bg, 0.72); border: 1px solid alpha(@overlay, 0.6); border-radius: 16px; padding: 28px 34px; }
label { color: @fg; }
combobox, dropdown { background-color: @surface; color: @fg; border-radius: 10px; border: 1px solid alpha(@overlay, 0.5); }
combobox:hover, dropdown:hover { border-color: @accent; }
entry { background-color: @surface; color: @fg; caret-color: @accent; border-radius: 10px; border: 2px solid alpha(@overlay, 0.5); padding: 8px 12px; }
entry:focus { border-color: @accent; }
entry.error { border-color: @urgent; }
button { background-color: @surface; color: @fg; border-radius: 10px; border: 1px solid alpha(@overlay, 0.5); padding: 8px 14px; }
button:hover { background-color: alpha(@accent, 0.22); border-color: @accent; }
button.suggested-action { background-color: @accent; color: @bg; border: none; }
CSS

chmod 644 "$OUT"
echo "wrote $OUT from $(jq -r .name "$PAL")"
